{
  "name": "mitome-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "hints:refresh": "bun scripts/generate-model-hints.ts --refresh",
    "check:fix": "effect-tsgo vp check --fix",
    "dev:docs": "vp run --filter @mitome/docs dev",
    "dev:cli": "bun scripts/dev-cli.ts",
    "build": "vp run -r build",
    "test": "vp run test:task",
    "build:pkgs": "vp run --fail-if-no-match --filter \"./packages/*\" build",
    "build:docs": "vp run --fail-if-no-match --filter @mitome/docs build",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "prepare": "vp config --no-agent && effect-tsgo patch"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.73.2",
    "@types/bun": "catalog:",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "publint": "0.3.25",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
