{
  "name": "mitome-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "hints:generate": "bun scripts/generate-model-hints.ts",
    "hints:refresh": "bun scripts/generate-model-hints.ts --refresh",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:root": "oxlint scripts/ tools/",
    "lint:root:fix": "oxlint --fix scripts/ tools/",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "check": "turbo run lint //#fmt check:types //#check:types",
    "check:fix": "turbo run lint:fix //#fmt:fix",
    "check:types": "tsc",
    "test": "turbo run test",
    "dev:docs": "turbo run dev --filter=@mitome/docs",
    "dev:cli": "bun scripts/dev-cli.ts",
    "build": "turbo run build",
    "build:pkgs": "turbo run build --filter='./packages/*'",
    "build:docs": "turbo run build --filter=@mitome/docs",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.73.2",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "catalog:",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "publint": "0.3.25",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
