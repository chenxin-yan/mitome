{
  "name": "mitome",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.0",
      "@types/bun": "^1.3.10",
      "@effect/ai-openai": "4.0.0-beta.98",
      "@effect/ai-openai-compat": "4.0.0-beta.98",
      "@effect/platform-bun": "4.0.0-beta.98",
      "@effect/vitest": "4.0.0-beta.98",
      "effect": "4.0.0-beta.98",
      "vitest": "4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "check": "turbo run lint //#fmt check:types",
    "check:fix": "turbo run lint:fix && turbo run //#fmt:fix",
    "check:types": "turbo run check:types",
    "test": "turbo run test",
    "dev:docs": "turbo run dev --filter=@mitome/docs",
    "dev:cli": "bun run --cwd packages/cli dev",
    "build": "turbo run build",
    "build:pkgs": "turbo run build --filter='./packages/*'",
    "build:docs": "turbo run build --filter=@mitome/docs",
    "test:release": "bun scripts/release-fixtures.ts",
    "version-packages": "changeset version && bun install --lockfile-only",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@effect/tsgo": "0.18.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.14"
}
