{
  "name": "mitome",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/cli/npm/*"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "@types/bun": "^1.3.14",
      "@effect/ai-openai": "4.0.0-beta.102",
      "@effect/ai-openai-compat": "4.0.0-beta.102",
      "@effect/platform-bun": "4.0.0-beta.102",
      "@effect/vitest": "4.0.0-beta.102",
      "effect": "4.0.0-beta.102",
      "vitest": "4.1.10",
      "@types/node": "^24.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "hints:generate": "bun scripts/generate-model-hints.ts",
    "hints:refresh": "bun scripts/generate-model-hints.ts --refresh",
    "lint": "oxlint scripts/ && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "check": "oxlint scripts/ && turbo run lint //#fmt check:types //#check:types",
    "check:fix": "turbo run lint:fix && turbo run //#fmt:fix",
    "check:types": "tsc",
    "test": "turbo run test",
    "dev:docs": "turbo run dev --filter=@mitome/docs",
    "dev:cli": "bun scripts/dev-cli.ts",
    "build": "turbo run build",
    "build:pkgs": "turbo run build --filter='./packages/*'",
    "build:docs": "turbo run build --filter=@mitome/docs",
    "test:release": "bun scripts/release-fixtures.ts",
    "version-packages": "changeset version && bun install --lockfile-only",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@effect/tsgo": "0.24.3",
    "@types/bun": "catalog:",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.6",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
