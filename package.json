{
  "name": "mitome",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.0",
      "@types/bun": "^1.3.10"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "check": "turbo run //#lint //#fmt check:types",
    "check:fix": "turbo run //#lint:fix //#fmt:fix",
    "check:types": "turbo run check:types",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "turbo": "^2.10.2"
  },
  "packageManager": "bun@1.3.10"
}
