{
  "name": "mitome",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.0",
      "@types/bun": "^1.3.10",
      "bunup": "0.16.32",
      "effect": "4.0.0-beta.97"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "check": "turbo run //#lint //#fmt check:types",
    "check:fix": "turbo run //#lint:fix //#fmt:fix",
    "check:types": "turbo run check:types",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:pkgs": "turbo run build --filter='./packages/*'",
    "build:docs": "turbo run build --filter=@mitome/docs",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.18.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.14"
}
