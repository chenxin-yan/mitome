{
  "name": "mitome-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "@types/bun": "^1.4.5",
      "@effect/ai-openai": "4.1.6",
      "@effect/ai-openai-compat": "4.1.6",
      "@effect/platform-bun": "4.1.6",
      "@effect/platform-node-shared": "4.1.6",
      "@effect/vitest": "4.1.6",
      "effect": "4.1.6",
      "vitest": "5.1.1",
      "@types/node": "^26.6.6"
    }
  },
  "type": "module",
  "scripts": {
    "hints:generate": "bun scripts/generate-model-hints.ts",
    "hints:refresh": "bun scripts/generate-model-hints.ts --refresh",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:root": "oxlint scripts/ tools/",
    "lint:root:fix": "oxlint --fix scripts/ tools/",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "check": "turbo run lint //#fmt check:types //#check:types",
    "check:fix": "turbo run lint:fix //#fmt:fix",
    "check:types": "tsc",
    "test": "turbo run test",
    "dev:docs": "turbo run dev --filter=@mitome/docs",
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=@mitome/docs",
    "version-packages": "changeset version && bun install --lockfile-only",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.73.2",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "catalog:",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "publint": "0.3.25",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.5"
}
