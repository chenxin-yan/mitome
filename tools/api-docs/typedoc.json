{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown", "./plugin.js"],
  "tsconfig": "./tsconfig.json",
  "entryPoints": [
    "../../packages/sdk/src/index.ts",
    "../../packages/sdk/src/effect.ts",
    "../../packages/sdk/src/extensions/index.ts",
    "../../packages/core/src/index.ts",
    "../../packages/providers/src/openai/index.ts",
    "../../packages/providers/src/openai-compatible/index.ts",
    "../../packages/providers/src/openai-codex/index.ts",
    "../../packages/tui/src/index.ts"
  ],
  "out": "../../apps/docs/content/docs/reference/api",
  "cleanOutputDir": true,
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "disableSources": true,
  "validation": {
    "notExported": false,
    "notDocumented": true
  },
  "fileExtension": ".md",
  "entryFileName": "index",
  "outputFileStrategy": "modules",
  "useCodeBlocks": true,
  "expandObjects": false,
  "expandParameters": false,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias"
  ],
  "name": "API",
  "router": "entry-point",
  "sortEntryPoints": false,
  "hidePageTitle": true,
  "treatWarningsAsErrors": true
}
