{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "//#lint": {
      "dependsOn": ["^build"]
    },
    "//#lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#fmt": {},
    "//#fmt:fix": {
      "cache": false
    },
    "check:types": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
