{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-lib.ts"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:root"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/tools/oxlint/**"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^build", "//#lint:root:fix"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputs": [],
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["scripts/**", "tools/**", ".oxlintrc.json"]
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#fmt": {},
    "//#check:types": {
      "outputs": []
    },
    "//#fmt:fix": {
      "cache": false
    },
    "check:types": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
