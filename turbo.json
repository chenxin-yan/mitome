{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#hints:generate": {
      "inputs": [
        "$TURBO_ROOT$/scripts/generate-model-hints.ts",
        "$TURBO_ROOT$/scripts/models-dev.snapshot.json",
        "$TURBO_ROOT$/packages/providers/src/openai-codex/models.ts"
      ],
      "outputs": [
        "packages/providers/src/openai/models.ts",
        "packages/create-mitome/src/model-hints.ts"
      ]
    },
    "//#api:generate": {
      "dependsOn": ["@mitome/core#build"],
      "inputs": [
        "$TURBO_ROOT$/scripts/generate-api-docs.ts",
        "$TURBO_ROOT$/tools/api-docs/*",
        "$TURBO_ROOT$/packages/sdk/src/**",
        "$TURBO_ROOT$/packages/providers/src/**",
        "$TURBO_ROOT$/packages/tui/src/**"
      ],
      "outputs": ["apps/docs/content/docs/reference/api/**"]
    },
    "build": {
      "dependsOn": ["^build", "//#hints:generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-lib.ts"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "//#hints:generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/tools/oxlint/**"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^build", "//#hints:generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputs": [],
      "cache": false
    },
    "//#fmt": {},
    "//#check:types": {
      "outputs": []
    },
    "//#fmt:fix": {
      "cache": false
    },
    "check:types": {
      "dependsOn": ["^build", "//#hints:generate"],
      "outputs": []
    }
  }
}
