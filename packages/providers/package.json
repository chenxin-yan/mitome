{
  "name": "@mitome/providers",
  "version": "0.0.0",
  "license": "MIT",
  "repository": "https://github.com/chenxin-yan/mitome",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./openai-compatible": {
      "types": "./dist/openai-compatible/index.d.ts",
      "default": "./dist/openai-compatible/index.js"
    },
    "./openai-codex": {
      "types": "./dist/openai-codex/index.d.ts",
      "default": "./dist/openai-codex/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@mitome/core": "workspace:*",
    "effect": "4.0.0-rc.108"
  },
  "engines": {
    "node": ">=24"
  }
}
