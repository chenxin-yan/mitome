{
  "name": "@mitome/providers",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./openai-compatible": {
      "types": "./dist/openai-compatible/index.d.ts",
      "default": "./dist/openai-compatible/index.js"
    },
    "./openai-codex": {
      "types": "./dist/openai-codex/index.d.ts",
      "default": "./dist/openai-codex/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test test"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@mitome/core": "workspace:*"
  }
}
