{
  "name": "@mitome/providers",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxin-yan/mitome.git",
    "directory": "packages/providers"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./anthropic": {
      "@mitome/source": "./src/anthropic/index.ts",
      "default": "./dist/anthropic/index.js"
    },
    "./openai": {
      "@mitome/source": "./src/openai/index.ts",
      "default": "./dist/openai/index.js"
    },
    "./openai-codex": {
      "@mitome/source": "./src/openai-codex/index.ts",
      "default": "./dist/openai-codex/index.js"
    },
    "./openai-compatible": {
      "@mitome/source": "./src/openai-compatible/index.ts",
      "default": "./dist/openai-compatible/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./anthropic": "./dist/anthropic/index.js",
      "./openai": "./dist/openai/index.js",
      "./openai-codex": "./dist/openai-codex/index.js",
      "./openai-compatible": "./dist/openai-compatible/index.js"
    },
    "access": "public"
  },
  "dependencies": {
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.23.0"
  },
  "peerDependencies": {
    "@mitome/core": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
