{
  "name": "create-mitome",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxin-yan/mitome.git",
    "directory": "packages/create-mitome"
  },
  "bin": {
    "create-mitome": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./template": {
      "types": "./dist/template.d.ts",
      "default": "./dist/template.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "check:types": "tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mitome/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.2"
  }
}
