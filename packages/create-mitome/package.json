{
  "name": "create-mitome",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxin-yan/mitome.git",
    "directory": "packages/create-mitome"
  },
  "bin": {
    "create-mitome": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./template": {
      "@mitome/source": "./src/template.ts",
      "default": "./dist/template.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./template": "./dist/template.js"
    },
    "access": "public"
  },
  "devDependencies": {
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@mitome/providers": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.2"
  }
}
