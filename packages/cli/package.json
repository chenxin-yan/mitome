{
  "name": "@mitome/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "mitome": "./dist/mitome"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun ./src/index.ts",
    "build": "bun build --compile --no-compile-autoload-dotenv src/index.ts --outfile dist/mitome",
    "build:release": "bun scripts/build-release.ts",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --testTimeout 15000"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@mitome/providers": "workspace:*",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
