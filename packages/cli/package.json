{
  "name": "@mitome/cli",
  "version": "0.0.0",
  "license": "MIT",
  "repository": "https://github.com/chenxin-yan/mitome",
  "bin": {
    "mitome": "./scripts/mitome.mjs"
  },
  "files": [
    "scripts/mitome.mjs",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun ./src/index.ts",
    "build": "bun build --compile --no-compile-autoload-dotenv src/index.ts --outfile dist/local/mitome",
    "build:release": "bun scripts/build-release.ts",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --testTimeout 15000"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@mitome/providers": "workspace:*",
    "@types/bun": "catalog:",
    "create-mitome": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@mitome/cli-darwin-arm64": "workspace:*",
    "@mitome/cli-darwin-x64": "workspace:*",
    "@mitome/cli-linux-arm64": "workspace:*",
    "@mitome/cli-linux-arm64-musl": "workspace:*",
    "@mitome/cli-linux-x64": "workspace:*",
    "@mitome/cli-linux-x64-musl": "workspace:*",
    "@mitome/cli-win32-arm64": "workspace:*",
    "@mitome/cli-win32-x64": "workspace:*"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
