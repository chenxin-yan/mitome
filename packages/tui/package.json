{
  "name": "@mitome/tui",
  "version": "0.0.0",
  "license": "MIT",
  "repository": "https://github.com/chenxin-yan/mitome",
  "files": [
    "dist/**/*.jsx",
    "dist/**/*.d.ts",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.jsx"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test --preload @opentui/solid/preload"
  },
  "dependencies": {
    "@opentui/core": "0.5.3",
    "@opentui/solid": "0.5.3",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@mitome/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
