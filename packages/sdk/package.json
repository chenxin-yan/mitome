{
  "name": "@mitome/sdk",
  "version": "0.0.0",
  "license": "MIT",
  "repository": "https://github.com/chenxin-yan/mitome",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@mitome/config": "workspace:*",
    "@mitome/core": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@mitome/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}
