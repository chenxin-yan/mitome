{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/tsgo/refs/heads/main/schema.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "customConditions": ["@mitome/source"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/ai-anthropic/AnthropicClient",
          "@effect/ai-anthropic/AnthropicLanguageModel",
          "@effect/ai-openai-compat/OpenAiClient",
          "@effect/ai-openai-compat/OpenAiLanguageModel",
          "@effect/ai-openai/OpenAiClient",
          "@effect/ai-openai/OpenAiLanguageModel",
          "@effect/platform-bun/BunPath",
          "@effect/platform-bun/BunRuntime",
          "@effect/platform-bun/BunServices",
          "@effect/platform-node-shared/NodeChildProcessSpawner",
          "@effect/platform-node-shared/NodeFileSystem",
          "@effect/platform-node-shared/NodePath",
          "@effect/vitest#beforeEach",
          "@effect/vitest#it",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/Terminal",
          "effect/ai/AiError",
          "effect/ai/LanguageModel",
          "effect/ai/Prompt",
          "effect/ai/Response",
          "effect/ai/Tool",
          "effect/ai/Toolkit",
          "effect/cli/Argument",
          "effect/cli/CliError",
          "effect/cli/CliOutput",
          "effect/cli/Command",
          "effect/cli/Flag",
          "effect/cli/Prompt",
          "effect/encoding/Sse",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientError",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/socket/Socket",
          "effect/testing/TestConsole"
        ]
      }
    ]
  }
}
