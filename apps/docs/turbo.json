{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["//#api:generate"],
      "persistent": true
    },
    "build": {
      "dependsOn": ["//#api:generate"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "check:types": {
      "outputs": [".source/**"]
    }
  }
}
